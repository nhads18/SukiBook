# SukiBook — Vercel + Supabase
# Copy to .env.local for local development, and add the same keys
# in Vercel → Project → Settings → Environment Variables.
#
# Without these keys the app runs in DEMO MODE (on-device data),
# so the same build works as a public demo and as a real deployment.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
